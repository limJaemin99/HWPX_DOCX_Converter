<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
    xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
    xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
    xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0"
    xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
    xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0"
    office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.text">
  <office:font-face-decls>
    <style:font-face style:name="함초롬바탕" svg:font-family="함초롬바탕"/>
  </office:font-face-decls>
  <office:styles>
    <style:default-style style:family="paragraph">
      <style:text-properties style:font-name="함초롬바탕" fo:font-size="10pt" fo:language="ko" fo:country="KR"
          style:font-name-asian="함초롬바탕" style:font-size-asian="10pt" style:language-asian="ko" style:country-asian="KR"/>
    </style:default-style>
    <style:style style:name="Standard" style:family="paragraph" style:class="text"/>
  </office:styles>
  <office:automatic-styles>
    <style:style style:name="PC" style:family="paragraph" style:parent-style-name="Standard">
      <style:paragraph-properties fo:text-align="center"/>
    </style:style>
    <style:style style:name="PH" style:family="paragraph" style:parent-style-name="Standard">
      <style:paragraph-properties fo:text-align="center"/>
      <style:text-properties fo:font-weight="bold" style:font-weight-asian="bold"/>
    </style:style>
    <style:style style:name="Tbl" style:family="table">
      <style:table-properties style:width="16cm" table:align="margins" fo:margin-top="6pt" fo:margin-bottom="6pt"/>
    </style:style>
    <style:style style:name="TblA" style:family="table-column">
      <style:table-column-properties style:column-width="2cm"/>
    </style:style>
    <style:style style:name="TblB" style:family="table-column">
      <style:table-column-properties style:column-width="3cm"/>
    </style:style>
    <style:style style:name="TblC" style:family="table-column">
      <style:table-column-properties style:column-width="8cm"/>
    </style:style>
    <style:style style:name="TblD" style:family="table-column">
      <style:table-column-properties style:column-width="3cm"/>
    </style:style>
    <style:style style:name="CellH" style:family="table-cell">
      <style:table-cell-properties fo:padding="0.1cm" fo:background-color="#d9d9d9"
          fo:border-top="0.5pt solid #000000" fo:border-left="0.5pt solid #000000"
          fo:border-right="0.5pt solid #000000" fo:border-bottom="1.5pt solid #000000"/>
    </style:style>
    <style:style style:name="Cell" style:family="table-cell">
      <style:table-cell-properties fo:padding="0.1cm" fo:border="0.5pt solid #000000" style:vertical-align="middle"/>
    </style:style>
    <style:style style:name="CellS" style:family="table-cell">
      <style:table-cell-properties fo:padding="0.1cm" fo:border="0.5pt solid #000000" fo:background-color="#fff2cc"/>
    </style:style>
    <style:page-layout style:name="pm1">
      <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" style:print-orientation="portrait"
          fo:margin-top="2cm" fo:margin-bottom="2cm" fo:margin-left="2.5cm" fo:margin-right="2.5cm"/>
    </style:page-layout>
  </office:automatic-styles>
  <office:master-styles>
    <style:master-page style:name="Standard" style:page-layout-name="pm1"/>
  </office:master-styles>
  <office:body>
    <office:text>
      <text:p text:style-name="Standard">대한민국헌법 제2장 국민의 권리와 의무</text:p>
      <table:table table:name="표1" table:style-name="Tbl">
        <table:table-column table:style-name="TblA"/>
        <table:table-column table:style-name="TblB"/>
        <table:table-column table:style-name="TblC"/>
        <table:table-column table:style-name="TblD"/>
        <table:table-header-rows>
          <table:table-row>
            <table:table-cell table:style-name="CellH" office:value-type="string"><text:p text:style-name="PH">조문</text:p></table:table-cell>
            <table:table-cell table:style-name="CellH" office:value-type="string"><text:p text:style-name="PH">권리·의무</text:p></table:table-cell>
            <table:table-cell table:style-name="CellH" office:value-type="string"><text:p text:style-name="PH">내용</text:p></table:table-cell>
            <table:table-cell table:style-name="CellH" office:value-type="string"><text:p text:style-name="PH">구분</text:p></table:table-cell>
          </table:table-row>
        </table:table-header-rows>
        <table:table-row>
          <table:table-cell table:style-name="Cell" office:value-type="string"><text:p text:style-name="PC">제24조</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" office:value-type="string"><text:p text:style-name="PC">선거권</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" office:value-type="string"><text:p text:style-name="Standard">모든 국민은 법률이 정하는 바에 의하여 선거권을 가진다.</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" office:value-type="string" table:number-rows-spanned="2"><text:p text:style-name="PC">권리</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" office:value-type="string"><text:p text:style-name="PC">제25조</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" office:value-type="string"><text:p text:style-name="PC">공무담임권</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" office:value-type="string"><text:p text:style-name="Standard">모든 국민은 법률이 정하는 바에 의하여 공무담임권을 가진다.</text:p></table:table-cell>
          <table:covered-table-cell/>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" office:value-type="string"><text:p text:style-name="PC">제38조</text:p></table:table-cell>
          <table:table-cell table:style-name="CellS" office:value-type="string"><text:p text:style-name="PC">납세의 의무</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" office:value-type="string"><text:p text:style-name="Standard">모든 국민은 법률이 정하는 바에 의하여 납세의 의무를 진다.</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" office:value-type="string" table:number-rows-spanned="2"><text:p text:style-name="PC">의무</text:p></table:table-cell>
        </table:table-row>
        <table:table-row>
          <table:table-cell table:style-name="Cell" office:value-type="string"><text:p text:style-name="PC">제39조</text:p></table:table-cell>
          <table:table-cell table:style-name="Cell" office:value-type="string" table:number-columns-spanned="2"><text:p text:style-name="Standard">①모든 국민은 법률이 정하는 바에 의하여 국방의 의무를 진다.</text:p></table:table-cell>
          <table:covered-table-cell/>
          <table:covered-table-cell/>
        </table:table-row>
      </table:table>
      <text:p text:style-name="Standard">제31조 ①모든 국민은 능력에 따라 균등하게 교육을 받을 권리를 가진다.</text:p>
    </office:text>
  </office:body>
</office:document>
